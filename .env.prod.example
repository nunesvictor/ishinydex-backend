# Copie para .env e troque todos os valores `change-me` antes de subir.
## db envs
POSTGRES_DB=ishinydex
POSTGRES_HOST=db
# gere com: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
POSTGRES_USER=postgres

## django project envs
ALLOWED_HOSTS="*"
DEBUG=False
DJANGO_SUPERUSER_EMAIL=admin@localhost
# senha do admin criado pelo entrypoint; gere uma senha forte
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_USERNAME=admin
# origens do frontend liberadas no CORS, separadas por vírgula
FRONTEND_ORIGINS="https://ishinydex.example.com"
PROJECT_APPS="core home pokedex"
# gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

## jupyterlab envs
DJANGO_ALLOW_ASYNC_UNSAFE=true
# gere com: python -c "import secrets; print(secrets.token_hex(24))"
JUPYTER_TOKEN=change-me
