# Ambiente de desenvolvimento (docker-compose.yml daqui): copie para .env e
# troque os valores `change-me`. O deploy usa o .env do repositório principal
# (https://github.com/nunesvictor/ishinydex).
## db envs
POSTGRES_DB=ishinydex
POSTGRES_HOST=db
# gere com: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
POSTGRES_USER=postgres

## django project envs
ALLOWED_HOSTS="*"
DEBUG=True
DJANGO_SUPERUSER_EMAIL=admin@localhost
# senha do admin criado pelo entrypoint; gere uma senha forte
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_USERNAME=admin
PROJECT_APPS="core home pokedex"
# gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
